---
interface Props {
  text: string;
  colorClass?: string;
}

const { text, colorClass = "bg-journal-yellow/50 dark:bg-journal-dark-yellow/50" } =
  Astro.props;
---

<span
  class:list={[
    "font-handwriting text-lg text-journal-ink py-1 px-3 border border-journal-ink/20 shadow-tape inline-block rotate-[0.5deg] hover:rotate-0 transition-transform",
    colorClass,
  ]}
>
  {text}
</span>