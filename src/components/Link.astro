---
import { cn } from "@/lib/utils";

type Props = {
  href: string;
  external?: boolean;
  underline?: boolean;
  class_?: string;
};

const { href, external, class_, underline = true, ...rest } = Astro.props;
---

<a
  href={href}
  target={external ? "_blank" : "_self"}
  class={cn(
    "inline-block font-bold text-current transition-all duration-200",
    class_,
    underline &&
      "border-b-2 border-journal-ink dark:border-journal-paper hover:bg-journal-yellow/50 dark:hover:bg-journal-dark-yellow/50 hover:text-journal-ink dark:hover:text-journal-paper hover:border-transparent dark:hover:border-transparent"
  )}
  {...rest}
>
  <slot />
</a>
